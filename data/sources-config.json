{
  "sources": {
    "arxiv": {
      "name": "arXiv",
      "description": "Open-access archive for preprints in physics, mathematics, computer science, and beyond.",
      "baseUrl": "https://export.arxiv.org/api/query",
      "paperCount": "2.5M+",
      "rateLimit": "1 request per 3 seconds",
      "coverage": ["Physics", "Mathematics", "Computer Science", "Quantitative Biology", "Statistics", "EE & Systems Science"],
      "color": "#b31b1b",
      "features": ["Open Access", "Preprints", "PDF Available"],
      "homepage": "https://arxiv.org"
    },
    "pubmed": {
      "name": "PubMed",
      "description": "Biomedical literature from MEDLINE, life science journals, and online books.",
      "baseUrl": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils",
      "paperCount": "38M+",
      "rateLimit": "10 requests per second (with API key)",
      "coverage": ["Medicine", "Biology", "Biochemistry", "Health Sciences", "Nursing", "Dentistry", "Veterinary Medicine"],
      "color": "#326898",
      "features": ["Peer Reviewed", "Medical Focus", "MeSH Terms", "ICite Citation Counts"],
      "homepage": "https://pubmed.ncbi.nlm.nih.gov"
    },
    "crossref": {
      "name": "CrossRef",
      "description": "Scholarly metadata for publications across all disciplines with DOI registration.",
      "baseUrl": "https://api.crossref.org/v1/works",
      "paperCount": "170M+",
      "rateLimit": "50 requests per second (polite pool)",
      "coverage": ["All Disciplines"],
      "color": "#ef8b2c",
      "features": ["DOI Registry", "Citation Data", "License Metadata"],
      "homepage": "https://www.crossref.org"
    },
    "openalex": {
      "name": "OpenAlex",
      "description": "Open catalog of scholarly works, authors, institutions, and topics.",
      "baseUrl": "https://api.openalex.org/works",
      "paperCount": "260M+",
      "rateLimit": "Unlimited (polite pool with email)",
      "coverage": ["All Disciplines"],
      "color": "#2563eb",
      "features": ["Free Forever", "Author Profiles", "Citation Networks", "Topic Tagging", "Autocomplete"],
      "homepage": "https://openalex.org"
    }
  },
  "defaults": {
    "resultsPerPage": 20,
    "maxResultsPerSource": 50,
    "cacheTimeMs": 900000,
    "timeoutMs": 25000
  },
  "citationFormats": [
    { "id": "bibtex", "name": "BibTeX", "description": "LaTeX bibliography format" },
    { "id": "apa", "name": "APA 7", "description": "American Psychological Association, 7th edition" },
    { "id": "mla", "name": "MLA 9", "description": "Modern Language Association, 9th edition" },
    { "id": "ris", "name": "RIS", "description": "Reference Manager / EndNote / Zotero" }
  ]
