# Application URL (used for OG metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contact email used in User-Agent strings to qualify for the polite pools
# of CrossRef and OpenAlex. Strongly recommended in production.
RESEARCH_CONTACT_EMAIL=hello@example.com

# Optional: PubMed/NCBI API key. Without one you get 3 req/s; with one, 10 req/s.
# Get yours at: https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_API_KEY=
